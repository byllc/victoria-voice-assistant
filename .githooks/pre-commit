#!/bin/sh
# Refuse to commit secrets files (docs/secrets.md). Turned on with: git config core.hooksPath .githooks
blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(\..+)?$' | grep -v -E '\.env\.example$')
if [ -n "$blocked" ]; then
    echo "Refusing to commit secrets files:" >&2
    echo "$blocked" | sed 's/^/  /' >&2
    echo "Secrets live in the Keychain and config/.env, which is never committed (docs/secrets.md)." >&2
    exit 1
fi
