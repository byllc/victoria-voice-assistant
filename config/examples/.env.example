LMS_API_KEY=replace-with-your-lm-studio-api-key
# ASSISTANT_WEB_PASSWORD (household web login) is deliberately NOT read from this file.
# Export it in the environment of the web process only.
# Add provider secrets only when those integrations are configured.
# ANTHROPIC_API_KEY=
# HERMES_API_KEY=
# VAPID_PRIVATE_KEY=   (created by `assistant push keys`; docs/push.md)
# HA_TOKEN=
# MUSIC_ASSISTANT_TOKEN=
